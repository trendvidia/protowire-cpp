# Split bindings and the anonymous list form: the inputs of protowire-go's
# rewrite_keyed_forms_test.go.

doc split.pxf
setkeyed children c type "Grid"
bytes

doc split.pxf
rmelem children c
bytes

doc split.pxf
rename children c z
rename children a c
bytes

doc split.pxf
insert children a "" !none
bytes

doc split.pxf
insert children d "" type = "X"
bytes

doc split.pxf
insert children a2 b type = "X"
bytes

doc split.pxf
move children c a
bytes

doc split.pxf
move children a c
bytes

doc split.pxf
move children a ""
bytes

doc anon.pxf
setkeyed regions us-east-1 replicas 5
rmkeyed regions us-east-1 replicas
rmelem regions us-east-1
insert regions x "" !none
rename regions us-east-1 x
move regions us-east-1 ""
bytes

