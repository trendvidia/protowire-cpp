keyedby regions name
setkeyed regions us-east-1 replicas 5
bytes

doc anon.pxf
keyedby regions name
setkeyed regions eu-west-2 tier "edge"
bytes

doc anon.pxf
keyedby regions name
rmkeyed regions us-east-1 replicas
