@type diff.v1.Vault
must = "m"
pw = "top"
nested = [ { must = "x" pw = "in-list" } { must = "y" pw { value = "block" hint = "h" } } ]
by_host = { a: { must = "x" pw = "in-map" } }
keys = ["k0", { value = "k1" fingerprint = "fp" }]
tenant = { acme: "t0" "b c": { value = "t1" } }
any { @type = "diff.v1.Vault" must = "z" pw = "in-any" }
